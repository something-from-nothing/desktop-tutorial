{
  "manifest_version": 3,
  "name": "Boot.dev Dashboard Link",
  "version": "1.0",
  "description": "Sends what you see on boot.dev to the Boot.dev Dashboard app on this PC. Nothing leaves your computer.",
  "content_scripts": [
    {
      "matches": ["https://www.boot.dev/*", "https://boot.dev/*"],
      "js": ["reader.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.boot.dev/*", "https://boot.dev/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ],
  "background": { "service_worker": "background.js" },
  "host_permissions": ["http://127.0.0.1:47822/*"],
  "icons": { "128": "icon128.png" }
}
