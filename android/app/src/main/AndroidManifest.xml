<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Model downloads and web search. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Scheduled chats: run on time, tell you the result, and survive a restart. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Only when you ask the AI about your calendar or contacts: Android asks you first. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Android Auto: notices the car's Bluetooth connecting, to have the conversation ready. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- No location, camera, microphone or storage. -->

    <!-- Lets "open an app" see which apps can be opened, without listing every package. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="Desk Agent"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- The Dashboard's own icon: Desk Agent opened straight on its Dashboard. Same app,
             same data, so there's nothing to connect or pair. -->
        <activity-alias
            android:name=".Dashboard"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="@string/dash_short"
            android:icon="@mipmap/ic_dashboard"
            android:roundIcon="@mipmap/ic_dashboard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Tells Android Auto this app has messaging style notifications it can read out. -->
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />

        <!-- Desk Agent Dashboard connects here without a code (only apps signed with Desk Agent's key). -->
        <activity
            android:name=".ConnectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".RunService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Alarms come only from this app; the restart and update notices come from Android. -->
        <receiver android:name=".AlarmReceiver" android:exported="false" />
        <!-- Android's download manager says a model download finished (it runs as another app). -->
        <receiver android:name=".ModelDownloads$Done" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
        </receiver>
        <!-- Android Auto: voice replies to the Desk Agent conversation. -->
        <receiver android:name=".Car$Reply" android:exported="false" />

        <service
            android:name=".PhoneControl"
            android:label="Desk Agent phone control"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/phone_control" />
        </service>
    </application>
</manifest>
